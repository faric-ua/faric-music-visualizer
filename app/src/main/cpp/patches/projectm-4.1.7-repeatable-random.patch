+void PresetTransition::SetClock(double seconds)
+{
+    // FARIC: the transition follows projectM's own clock (the video's time in an export), not the wall clock.
+    if (m_startClock < 0.0 || seconds < m_startClock)
+    {
+        m_startClock = seconds;
+        m_lastClock = seconds;
+    }
+    m_clock = seconds;
+}
+
+auto PresetTransition::SecondsSinceStart() const -> double
+{
+    if (m_startClock < 0.0)
+    {
+        return std::chrono::duration<double>(std::chrono::system_clock::now() - m_transitionStartTime).count();
+    }
+    return m_clock - m_startClock;
+}
+
