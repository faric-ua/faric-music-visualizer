diff --git a/src/api/include/projectM-4/parameters.h b/src/api/include/projectM-4/parameters.h
--- a/src/api/include/projectM-4/parameters.h
+++ b/src/api/include/projectM-4/parameters.h
@@ -47,0 +48,20 @@
+/**
+ * @brief Sets a custom time value to use for the next rendered frame.
+ *
+ * This is a minimal FARIC backport of the projectM 4.2 frame-time API.
+ * Values >= 0 use the supplied timeline time; values < 0 return to the
+ * system clock.
+ *
+ * @param instance The projectM instance handle.
+ * @param seconds_since_first_frame Fractional seconds since the first frame.
+ */
+PROJECTM_EXPORT void projectm_set_frame_time(projectm_handle instance,
+                                             double seconds_since_first_frame);
+
+/**
+ * @brief Returns the time used by the most recently rendered frame.
+ * @param instance The projectM instance handle.
+ * @return Time used for the most recently rendered frame.
+ */
+PROJECTM_EXPORT double projectm_get_last_frame_time(projectm_handle instance);
+

