diff --git a/src/libprojectM/FaricRandom.hpp b/src/libprojectM/FaricRandom.hpp
new file mode 100644
index 0000000..91cdc35
--- /dev/null
+++ b/src/libprojectM/FaricRandom.hpp
@@ -0,0 +1,41 @@
+#pragma once
+
+// FARIC (PulseDeck V204): «щоразу однаково» — every random number projectM takes for a video can come from one
+// seeded generator, so the same piece of a song gives the same picture. Off = projectM's own randomness.
+
+#include <cstdint>
+#include <random>
+
+namespace libprojectM {
+namespace FaricRandom {
+
+inline bool& EnabledFlag()
+{
+    static bool enabled{false};
+    return enabled;
+}
+
+inline std::mt19937& Engine()
+{
+    static std::mt19937 engine{0x4141f00du};
+    return engine;
+}
+
+inline auto Enabled() -> bool
+{
+    return EnabledFlag();
+}
+
+inline auto Next() -> uint32_t
+{
+    return static_cast<uint32_t>(Engine()());
+}
+
+inline void Set(bool enabled, uint32_t seed)
+{
+    EnabledFlag() = enabled;
+    Engine().seed(seed);
+}
+
+} // namespace FaricRandom
+} // namespace libprojectM
